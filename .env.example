DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite by default. For PostgreSQL set:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_extraction
DATABASE_URL=sqlite:///db.sqlite3

# Extraction provider: mock for deterministic local/demo tests, generic for a real provider.
EXTRACTION_PROVIDER=mock
EXTERNAL_API_BASE_URL=
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_VERIFY_SSL=True
EXTERNAL_API_TOKEN=

# Async processing
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Security
API_AUTH_ENABLED=False
API_KEY=

# Limits
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_PER_MINUTE=30

# Observability
LOG_LEVEL=INFO
